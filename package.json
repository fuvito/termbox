{
  "name": "termbox",
  "version": "1.0.5",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "vite",
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "biome lint src",
    "icons": "node scripts/generate-icons.mjs",
    "screenshots": "node scripts/take-screenshots.mjs",
    "marquee": "node scripts/generate-marquee.mjs",
    "prepackage": "npm run lint && npm run typecheck && npm run test:coverage && npm run test:e2e",
    "package": "npm run build && node scripts/zip.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
