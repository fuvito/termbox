{
  "manifest_version": 3,
  "name": "TermBox",
  "version": "1.0.6",
  "description": "Build your own glossary from any CSV. 5 built-in domain glossaries, PIN protection, 12 languages. Fully offline, no account.",
  "homepage_url": "https://fuatyazar.com/termbox",
  "minimum_chrome_version": "102",
  "permissions": ["storage"],
  "optional_host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TermBox",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
